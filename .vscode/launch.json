{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug node (node1)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/node",
      "args": [
        "-id",
        "node1",
        "-grpc-addr",
        ":9001",
        "-http-addr",
        ":8001",
        "-peers",
        ""
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug kvs (main.go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
